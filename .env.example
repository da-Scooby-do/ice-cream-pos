# رابط مشروع Supabase | Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://pccxrybaxuwwbnatgyra.supabase.co

# المفتاح السري — على السيرفر فقط، لا يُعرض في المتصفح أبداً
# Secret key — server-side only, NEVER exposed to the browser.
# Supabase → Project Settings → API Keys → "Secret keys" (sb_secret_...)
# (a legacy service_role JWT also works)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# سر توقيع جلسة الدخول | session cookie signing secret
# توليده: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
