# رابط مشروع Supabase | Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# مفتاح الخدمة — سري، لا يُعرض في المتصفح أبداً
# Service-role key — server-side only, NEVER exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# سر توقيع جلسة الدخول | session cookie signing secret
# توليده: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
