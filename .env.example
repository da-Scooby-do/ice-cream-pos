# =====================================================================
# Only needed for the CLOUD part (Vercel): the owner's phone reports and
# the backup the laptop app uploads to. The laptop app itself needs none
# of these — it runs fully offline with its own database.
# =====================================================================

# رابط مشروع Supabase | Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://pccxrybaxuwwbnatgyra.supabase.co

# المفتاح السري — على السيرفر فقط | Secret key — server-side only, never shared.
# Supabase → Project Settings → API Keys → "Secret keys" (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# رمز الربط بين اللابتوب والسحابة | the laptop's sync password.
# Make up a long random value (20+ characters). Put the SAME value in the
# laptop app: الإعدادات ← النسخة السحابية ← رمز الربط.
SYNC_TOKEN=

# اختياري | optional cookie-signing secret (derived from the Supabase key if unset)
# SESSION_SECRET=
